# Copy this file to ".env" and put your key in it. ".env" is gitignored.
# A real environment variable always overrides what is written here.

# One of these two is enough.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional.
# JOB_INBOX_PROVIDER=anthropic     # which one wins when both keys are present
# JOB_INBOX_LLM_MODEL=claude-opus-5
# JOB_INBOX_ADVISOR=findings       # findings | verdict | off
